# Copy to .env and fill in. .env is gitignored and must stay that way.
# On Fly, these are set with `fly secrets set KEY=value` and never written to
# a file at all.

# ---------------------------------------------------------------------------
# Kalshi
# ---------------------------------------------------------------------------
# The API key ID -- this is an identifier, not a secret blob.
KALSHI_API_KEY=

# Absolute path to the RSA private key PEM. Keep this file OUTSIDE the repo.
# The existing key from the previous project lives at ~/.kalshi/private_key_2.pem
# and that is the right kind of location. The key must be RSA, not ED25519.
KALSHI_PRIVATE_KEY_PATH=

KALSHI_REST_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# ---------------------------------------------------------------------------
# The Odds API  (https://the-odds-api.com)
# ---------------------------------------------------------------------------
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Free tier is 500 credits/month. Cost per call = markets x regions, so h2h +
# spreads + totals across us + eu is 6 credits per sport per sweep. The
# allocator refuses calls that would breach the daily budget; set this
# deliberately rather than letting a poll loop drain the month in a day.
ODDS_DAILY_CREDIT_BUDGET=16
ODDS_REGIONS=us,eu
ODDS_MARKETS=h2h,spreads,totals

# When the daily budget rolls over, UTC hour. NOT midnight: 00:00Z is 8pm ET /
# 5pm PT, the middle of the US evening slate, so a calendar day splits one
# night's games across two budget buckets and the late West Coast games compete
# for credits with the next afternoon. 10:00Z is 6am ET / 3am PT, after even an
# extra-innings game has finished. The *monthly* boundary stays on the calendar
# because that one belongs to The Odds API.
ODDS_BUDGET_DAY_START_UTC_HOUR=10

# ---------------------------------------------------------------------------
# Staleness contract. An opportunity outside either bound is not bettable --
# enforced server-side on the order endpoint, not just greyed out in the UI.
#
# These two bound the SAME window and the tighter one decides it. The books
# last 15 minutes; a Kalshi quote lasts 30 seconds; the recorder polls every 15
# minutes. So a row is bettable for about thirty seconds after each pass, not
# for fifteen -- see the top item in tasks/NEXT.md.
# ---------------------------------------------------------------------------
MAX_ODDS_AGE_S=900
MAX_KALSHI_QUOTE_AGE_S=30

# ---------------------------------------------------------------------------
# Risk. All money in the risk path is integer tenths of a cent; these are
# dollars for human legibility and are converted at the boundary.
# ---------------------------------------------------------------------------
BANKROLL_DOLLARS=1000
KELLY_FRACTION=0.25
MAX_ORDER_CONTRACTS=50
MAX_POSITION_DOLLARS=100
MAX_EXPOSURE_DOLLARS=400
MAX_DAILY_LOSS_DOLLARS=100
# Fees round up on the whole order under one candidate model, so many tiny
# orders cost proportionally far more than one sensible one.
MIN_ORDER_CONTRACTS=10

# ---------------------------------------------------------------------------
# The live gate. Defaults to LOCKED. It opens only when the paper record earns
# it: >=300 scored recommendations, positive CLV surviving the noise guard, and
# fee_predicted == fee_actual across every recorded fill.
# ---------------------------------------------------------------------------
LIVE_TRADING_ENABLED=false
LIVE_GATE_MIN_SCORED_RECOMMENDATIONS=300

# ---------------------------------------------------------------------------
# Instance mode. "demo" serves deterministic seeded data with no credentials
# and no execution path. "live" is the private authenticated instance.
# ---------------------------------------------------------------------------
INSTANCE_MODE=demo

# Session token for the live instance. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Agents (Anthropic Messages API). Scout / Skeptic / Historian.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Discord alerting. Alerts only -- the embed links into the cockpit, it never
# carries an order button.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
COCKPIT_BASE_URL=http://localhost:3000
