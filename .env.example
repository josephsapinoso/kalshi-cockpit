# Copy to .env and fill in. .env is gitignored and must stay that way.
# On Fly, these are set with `fly secrets set KEY=value` and never written to
# a file at all.

# ---------------------------------------------------------------------------
# Kalshi
# ---------------------------------------------------------------------------
# The API key ID -- this is an identifier, not a secret blob.
KALSHI_API_KEY=

# Absolute path to the RSA private key PEM. Keep this file OUTSIDE the repo.
# The existing key from the previous project lives at ~/.kalshi/private_key_2.pem
# and that is the right kind of location. The key must be RSA, not ED25519.
KALSHI_PRIVATE_KEY_PATH=

KALSHI_REST_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# ---------------------------------------------------------------------------
# The Odds API  (https://the-odds-api.com)
# ---------------------------------------------------------------------------
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Cost per call = markets x regions, so h2h + spreads + totals across us + eu is
# 6 credits per sport per sweep. The allocator refuses calls that would breach
# either budget; set both deliberately rather than letting a poll loop drain the
# month in a day.
#
#   free tier   500/month    -> 16/day. Two sweeps, two 15-minute windows. The
#                               live instance measured what that costs:
#                               stale_odds on 256 of 265 suppressed rows.
#   20K tier    20,000/month -> 400/day is what the deployed instance uses.
#
# **Player props cost an order of magnitude more per sweep.** Props are a
# PER-EVENT endpoint: five market keys plus their `_alternate` twins -- ten keys
# -- billed per key per region. So one event costs `10 x len(ODDS_REGIONS)`,
# which at the `us,eu` below is **20 credits per fixture**, against six for a
# whole team sweep.
#
# **The previous version of this note said "roughly ten credits a fixture" and
# "a fifteen-game MLB slate is ~150 credits". Both were wrong, and the way they
# were wrong is the lesson.** The fixture count was assumed at 15 and the region
# count was never read, so two unchecked inputs compounded in the same
# direction. On 2026-08-15 the first live prop sweep spent **384 of 400 in a
# single pass** -- 27 fixtures at 20 -- and refused every remaining odds sweep
# that day, team sweeps included. The moneyline record, which is what the CLV
# gate accumulates, stopped growing.
#
# Two things now bound it, and both are code rather than a note here:
# `fetch_and_store_props` buys only the fixtures the sweep's own slot covers,
# and `decide_sweeps` reserves `cost + 20 x games_covered` before authorising a
# firing at all. See `backend/odds/timing.py`.
#
# **No per-slate figure is written here on purpose.** The next one goes in only
# after it has been read off `api_credits` and reconciled against the provider's
# own `x-requests-used` header (`BudgetState.drift`) on a real slate. A cost
# derived from an assumed input is the assumption restated, and writing it into
# this file converts a guess into documentation the next reader has no reason to
# doubt.
#
# At the free-tier 16 below, the budget refuses every prop event and the prop
# pipeline then runs end to end against an empty table and reports a clean zero
# -- inert, and quiet about it. `fetch_props` records each refusal in
# `odds_sweep_log`, so the state is visible rather than silent, and that log is
# the thing to read after a deploy.
#
# The live instance is at 400/day and 13,000/month (`fly.live.toml`). The number
# to watch is the monthly one once a second league's team sweeps come back in
# the autumn.
#
# Left at the free-tier value here because this file is the contract for a fresh
# clone, and a default that assumes a paid plan would drain someone's month on
# their first run. The deployed values live in fly.live.toml.
ODDS_DAILY_CREDIT_BUDGET=16

# Our own monthly ceiling, separate from the plan's. Optional: unset means no
# ceiling of ours, and the provider's x-requests-remaining still refuses. Unset
# is NOT the same as 0, which would refuse every call.
#
# Worth setting once anything can spend at a different rate than a sweep: the
# historical endpoints cost 10 x markets x regions, so one backfill loop can
# spend a month inside a single day without the daily cap objecting. Setting it
# below the plan also reserves headroom for that work, so a backfill and the
# live sweeps cannot starve each other.
# ODDS_MONTHLY_CREDIT_BUDGET=13000

ODDS_REGIONS=us,eu

# A team sweep costs len(ODDS_MARKETS) * len(ODDS_REGIONS) credits, so every key
# added here multiplies the bill for every sport on every refresh.
#
# `h2h` only. `spreads` and `totals` were bought until 2026-08-16 and read by
# NOTHING: the pricing path takes `market=MONEYLINE` ("h2h") from its only call
# site (runner.py:1218), and linker.py:281 refuses every non-two-sided Kalshi
# event, so spread and total have never priced for any sport. Adding them back
# triples the cost and changes no output until that refusal is lifted.
ODDS_MARKETS=h2h

# Whether a SCHEDULED sweep also buys player props for every fixture it covers.
# Off, and the default is the decision -- see ADR 0032 and fly.live.toml, which
# carries the arithmetic. Props were 86% of a cluster's bill and added no
# cluster to the 300-game floor, because a prop event inherits its game's
# `odds_event_id` (gate.py:424-428).
#
# Props are still available one fixture at a time via POST /api/odds/refresh,
# for 26 credits, bought for a game somebody is actually looking at.
ODDS_BUY_PROPS_ON_SCHEDULE=false

# When the daily budget rolls over, UTC hour. NOT midnight: 00:00Z is 8pm ET /
# 5pm PT, the middle of the US evening slate, so a calendar day splits one
# night's games across two budget buckets and the late West Coast games compete
# for credits with the next afternoon. 10:00Z is 6am ET / 3am PT, after even an
# extra-innings game has finished. The *monthly* boundary stays on the calendar
# because that one belongs to The Odds API.
#
# **It cuts three days, not one**, and the name only mentions the first: the
# odds credit budget, the RISK day the daily-loss kill switch measures realised
# P&L over (`backend/settlement.py`, `backend/core/sizing.py`), and the
# Anthropic call budget (`backend/agents/budget.py`). Every one of those has a
# signature defaulting to `odds/timing.DEFAULT_DAY_START_UTC_HOUR = 10`, so
# setting this to anything else puts any call site that forgets the argument on
# a different day from the ones that pass it. A later day start counts LESS of
# today's losses as today's, which engages the kill switch LESS -- the
# permissive direction. `assert_risk_day_start_agrees` in `backend/config.py`
# REFUSES TO START when this and the constant disagree; change both or neither.
ODDS_BUDGET_DAY_START_UTC_HOUR=10

# ---------------------------------------------------------------------------
# Staleness contract. An opportunity outside either bound is not bettable --
# enforced server-side on the order endpoint, not just greyed out in the UI.
#
# These two bound the SAME window and the tighter one decides it. The books
# last 15 minutes; a Kalshi quote lasts 30 seconds; the recorder polls every 15
# minutes. So a row is bettable for about thirty seconds after each pass, not
# for fifteen -- see the top item in tasks/NEXT.md.
#
# NEITHER OF THESE CAN BE CHANGED HERE ALONE. Each has a twin in
# `SuppressionConfig` (`max_odds_age_ms`, `max_kalshi_quote_age_ms`) that is
# hardcoded and does not read the environment, and the API and the runner both
# REFUSE TO START when a pair disagrees -- `assert_odds_age_limits_agree` and
# `assert_kalshi_quote_age_limits_agree` in `backend/config.py`, ADR 0019
# section 6. That is deliberate: without it, moving the value here left the
# suppression gauntlet on the old limit while the order gate moved, so the
# Board offered rows as bettable that the order endpoint then refused, with
# nothing on either side logging the disagreement. To change one, change the
# matching field in `backend/core/suppression.py` in the same commit.
# ---------------------------------------------------------------------------
MAX_ODDS_AGE_S=900
MAX_KALSHI_QUOTE_AGE_S=30

# ---------------------------------------------------------------------------
# Risk. All money in the risk path is integer tenths of a cent; these are
# dollars for human legibility and are converted at the boundary.
# ---------------------------------------------------------------------------
# Your RUNNING BALANCE, not a weekly top-up. Every cap below is a stock and a
# weekly deposit is a flow; entering the flow here makes each cap several times
# looser than it reads by the end of a month.
#
# The caps below are 10% / 40% / 10% of it. Keep those fractions when you change
# the bankroll -- lowering the bankroll alone leaves a position cap larger than
# the account and a daily loss limit that can only fire after everything is gone.
#
# This does NOT decide what the evidence record counts. The gate's `actionable`
# counter is scored against a reference bankroll fixed in code, so the size of
# your deposit cannot silently pin the 300-game floor at zero. See ADR 0015.
#
# BANKROLL_DOLLARS, MAX_POSITION_DOLLARS, MAX_EXPOSURE_DOLLARS and
# MAX_DAILY_LOSS_DOLLARS are RETIRED (ADR 0045): the four dollar quantities
# are derived from the venue's own observed balance
# (`venue_balance_snapshots`) at each sizing decision, never typed. Setting
# any of them is announced at ERROR on every config load and on /api/health,
# and is never read. Only the two strategy parameters remain configurable:
KELLY_FRACTION=0.25
MAX_ORDER_CONTRACTS=50
# MIN_ORDER_CONTRACTS is GONE. Setting it is ANNOUNCED at ERROR on every config
# load and shown on /api/health, and is never read -- it does not raise, because
# `RiskConfig.load` runs at boot under `wait -n` and a raise there is a crash
# loop clearable only with flyctl. It was a flat floor standing in for the
# per-order fee rounding penalty, which is price-dependent: measured, 0.00c at
# 50c at every size, and at most 0.88c on a single contract in the 20c/80c band.
# `core.sizing` re-evaluates the actual order at the actual size instead.

# ---------------------------------------------------------------------------
# Recording Kalshi's settled outcome (backend/market_results.py). All three are
# here rather than as constants because they are the knobs a chatty or a
# leaking pass would need turned, and the alternative on a deployed instance is
# a code change plus a deploy.
#
# Unlike everything above, a bad value here is ANNOUNCED at ERROR and the
# default is used -- it never raises. These are loaded by the recording loop,
# which the container supervises with `wait -n`, so a raise would be a crash
# loop clearable only with flyctl. Same reasoning as MIN_ORDER_CONTRACTS below.
# ---------------------------------------------------------------------------
# How long after a game starts to begin asking whether it settled. Shorter than
# any sport in scope, so the first ask usually finds the market still active --
# the cheap direction, since Kalshi REST is unmetered and spends no odds
# credits, while being late lags the calibration sample for no reason.
MARKET_RESULT_MIN_AGE_S=7200

# When to stop asking. A market whose game commenced longer ago than this is
# dropped from the queue, and that is a REAL LOSS: a settlement that genuinely
# lands on day eight is never recorded and the row stays NULL. The alternative
# is worse -- one never-settling event costs ~96 requests a day forever, and the
# capture already holds one `closed` with no result ~6 months past its
# expiration. Dropped markets are counted as `outcome_abandoned_total` on every
# pass line with the oldest named, and raising this value brings them straight
# back: abandonment is an age bound on a query, not a flag written to a row.
MARKET_RESULT_MAX_AGE_S=604800

# Optional ceiling on how many events one pass may ask about. Unset means
# uncapped, which is the behaviour the pass shipped with. Unset is NOT 0 -- 0
# would mean "ask about nothing", and is refused as a value. Events skipped by
# the cap are reported as `outcome_deferred_events`, never silently dropped.
# MARKET_RESULT_MAX_EVENTS_PER_PASS=200

# ---------------------------------------------------------------------------
# The live gate. Defaults to LOCKED. It opens only when the paper record earns
# it: >=300 scored recommendations, positive CLV surviving the noise guard, and
# fee_predicted == fee_actual across every recorded fill.
# ---------------------------------------------------------------------------
LIVE_TRADING_ENABLED=false
LIVE_GATE_MIN_SCORED_RECOMMENDATIONS=300

# ---------------------------------------------------------------------------
# Instance mode. "demo" serves deterministic seeded data with no credentials
# and no execution path. "live" is the private authenticated instance.
# ---------------------------------------------------------------------------
INSTANCE_MODE=demo

# GIT_SHA is DELIBERATELY NOT HERE, and must not be added. It is what
# /api/health reports as the running commit, and it is supplied per deploy:
#
#   fly deploy -c fly.live.toml -e GIT_SHA="$(git rev-parse HEAD)"
#
# Put in a file, it goes stale the moment you commit, and a stale commit
# reported confidently is worse than none at all -- which is the whole reason
# the field exists. Unset, it reports null. See `backend/config.py`, section
# "build identity", and ADR 0040.

# Session token for the live instance. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Agents (Anthropic Messages API). Scout / Skeptic / Historian.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# Ceilings on Anthropic spend. Both are enforced by `backend/agents/budget.py`,
# which refuses calls the way `odds/budget.py` refuses credits -- it does not
# warn and proceed.
#
# **Set these before setting the key, not after.** Until 2026-08-11 this path
# had no ceiling at all: the Skeptic fanned out over every surfaced row with no
# cap, on a loop that wakes up to 96 times a day. The only thing holding the
# bill at zero was that no row has ever surfaced, which is a measurement
# outcome, not a setting -- the system was arranged to begin spending, without
# limit, at the moment the project first worked.
#
# Cost. The count is the guarantee; the dollars are conditional.
#
# **24 calls a day is 24 HTTP requests a day**, because `build_client` passes
# `max_retries=0` -- one candidate is exactly one request. That holds whatever a
# call costs. (Until 2026-08-11 it did not: the SDK's default of two retries let
# 24 counted calls become up to 72 billed requests, invisibly to the meter.)
#
# In dollars: a call is ~1,730 input tokens (401 shared context + ~584 Skeptic
# system + ~330 prompt + ~415 for the response JSON schema, which is sent as
# `output_format` and billed as INPUT) and up to 3,000 output, because
# `skeptic.evaluate` sets `max_tokens=3000` and adaptive thinking bills thinking
# as output. At a claude-opus-5 list price of $5 / $25 per million -- which is
# **[ASSUMED, uncited]**; nothing in this repo cites it and no invoice has
# confirmed it -- that is **$0.014-$0.084 a call, so $0.35-$2.01 a saturated
# day** and roughly $10-$60 a month. Quote the range, or quote the count.
# `backend/agents/base.py` carries the full derivation.
#
# Per pass: bounds ONE fan-out. Every surfaced row in a pass is reviewed in a
# single `asyncio.gather`, so without this one pathological slate is one
# unbounded batch.
AGENT_MAX_CALLS_PER_PASS=8

# Per day: this is the money control -- the day's total is 24 for ANY per-pass
# value in [1, 24], because `agents/budget.py` puts both ceilings in one
# `min()`. (An earlier version of this comment said "96 passes at the per-pass
# cap would be 768 calls, about $35". That is not reachable by any
# configuration; the per-pass cap distributes the day's 24 across passes, it
# does not multiply them.) The day rolls at ODDS_BUDGET_DAY_START_UTC_HOUR, the
# same sports day the odds budget uses -- true since 2026-08-11 and not before:
# `AgentBudget.from_config` passed no hour, so this sentence described an
# intention while the code took the hardcoded 10. The count is read from the
# `agent_calls` table rather than held in memory, so a restart cannot reset it.
# Rows are written BEFORE the call and updated with the verdict after, so a
# crash mid-fan-out over-counts rather than under-counts.
#
# Zero is a valid value and means "make no calls" -- a way to hold the fleet at
# zero spend without unsetting the key. A malformed value RAISES rather than
# falling back to the default; a silently-defaulted cost cap is how you find out
# your limit was unset from an invoice.
#
# When a ceiling binds, the rows it could not review come back suppressed with
# `skeptic_unreviewed` rather than surfacing unreviewed. That is deliberate and
# it cuts both ways: a ceiling set too low costs bets, not just dollars. Watch
# `skeptic_unreviewed` in the pass log.
AGENT_MAX_CALLS_PER_DAY=24

# ---------------------------------------------------------------------------
# Discord alerting. Alerts only -- the embed links into the cockpit, it never
# carries an order button.
# ---------------------------------------------------------------------------
# One of these two. The webhook is the one to use: it is four taps inside the
# Discord mobile app (channel -> Edit Channel -> Integrations -> Webhooks ->
# New Webhook -> Copy URL), it needs no developer portal or OAuth invite, and it
# is the SMALLER credential -- a bot token works everywhere the bot was added,
# a webhook only in the one channel it was made in.
#
# It carries its token in the URL PATH, so it is redacted by
# backend/logging_setup.py the same way the Odds key is. Never paste one into a
# terminal you are sharing.
DISCORD_WEBHOOK_URL=

# The older path. Both must be set for it to take effect, and the webhook above
# wins if it is also set.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
COCKPIT_BASE_URL=http://localhost:3000
