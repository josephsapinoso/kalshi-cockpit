{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/session_context.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/scripts/session_context.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
