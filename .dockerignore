# Keep the build context small and, more importantly, keep secrets out of it.
# Anything sent to the daemon can end up in an image layer.

.env
.env.*
!.env.example
*.pem
*.key
secrets/

.git/
.github/

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

frontend/node_modules/
frontend/.next/
frontend/out/

# Local databases and the Parquet lake. The live instance builds these on its
# volume; the demo regenerates from seed on boot.
data/
*.db
*.db-*
*.sqlite*
*.duckdb*
*.parquet
warehouse/target/
warehouse/dbt_packages/
warehouse/logs/

# tests/fixtures IS needed in the repo but not in the runtime image.
tests/
docs/
tasks/

# Dev and capture tooling stays out -- but `run_loop.py` is the live
# entrypoint's own process, not a dev script. Excluding the whole directory
# built an image that started, reported healthy and served pages while the one
# process that grows the evidence record was simply absent from the filesystem.
# Everything else here either hits the API or exists only to build fixtures.
scripts/*
!scripts/run_loop.py

*.md
!README.md
